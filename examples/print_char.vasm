; syscall_test.vasm - Print character 'A' using syscalls
        mov r0, #65            ; character 'A'
        mov r1, sp             ; use stack as buffer
        strb r0, [r1, #0]      ; store byte at buffer
        mov r0, #1             ; fd = stdout
        mov r2, #1             ; length = 1
        mov r7, #3             ; syscall = WRITE
        swi                    ; write to stdout

        mov r0, #0             ; exit code = 0
        mov r7, #1             ; syscall = EXIT
        swi                    ; exit
