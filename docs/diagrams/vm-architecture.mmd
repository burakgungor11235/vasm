        DATA[("0x2000-0x5FFF\n.data 数据段\n16KB")]
        STACK[("0x6000-0xFFFF\nStack/Heap\n40KB")]
    end

    TEXT -->|"动态扩展"| LPOOL
    LPOOL -->|"动态扩展"| DATA
    DATA -->|"向上增长"| STACK
```

```mermaid
flowchart TB
