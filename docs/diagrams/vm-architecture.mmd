```mermaid
flowchart LR
    subgraph "指令格式"
        direction TB
        B[("31 30 29 28\nCond")] --> C[("27 26 25\nOpcode")]
        C --> D[("24 23\nRn")]
        D --> E[("22 21\nRd")]
        E --> F[("20-0\nOperand2")]
    end

    subgraph "位域说明"
        G["Cond: 4位\n条件码"]
        H["Opcode: 3位\n操作码"]
