```mermaid
flowchart TB
    subgraph "符号表: FNV-1a 哈希 + 线性探测"
        direction TB
        HASH["哈希函数\nFNV-1a 32位"]
        PROBE["冲突解决\n线性探测\n开放寻址"]
    end

    subgraph "查找过程"
        START["输入: 标签名"] --> CALC["计算哈希索引"]
        CALC --> CHECK["检查槽位是否为空"]
        CHECK -->|"为空| FOUND["未找到\n返回 -1"]
        CHECK -->|"不为空| MATCH["匹配标签名?"]
        MATCH -->|"是| FOUND2["找到\n返回地址"]
        MATCH -->|"否| NEXT["探测下一个槽位"]
        NEXT --> CHECK
    end
```

```mermaid
flowchart LR
